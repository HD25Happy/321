<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PhoneCardTracker.Models"
             x:Class="PhoneCardTracker.Views.FavoritesPage"
             Title="Mine Favoritter">

    <Grid RowDefinitions="Auto, *" Padding="16">

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Stroke="{StaticResource Gray500}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Favorit Kortsæt ★"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                <Label x:Name="SubtitleLabel"
                       Text="Dine udvalgte sæt på tværs af spil"
                       FontSize="13"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>
        </Border>

        <!-- Liste over favoritter -->
        <CollectionView Grid.Row="1"
                        x:Name="FavCollectionView"
                        SelectionMode="None">

            <!-- Tom visning hvis ingen favoritter er valgt endnu -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60">
                    <Label Text="Ingen favoritter endnu ★"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="Gå til fanen 'Alle Sæt' og tryk på stjernen ud for de sæt, du vil gemme her."
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Gray500}"
                           Padding="20,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CardSet">
                    <Border Margin="0,4"
                            Padding="14,10"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{StaticResource Gray500}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSetTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- Fjern/Toggle Stjerne-knap -->
                            <Button Grid.Column="0"
                                    Text="★"
                                    TextColor="#F59E0B"
                                    FontSize="24"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Clicked="OnUnfavoriteClicked"
                                    CommandParameter="{Binding .}" />

                            <!-- Sæt detaljer -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding SetName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                <Label Text="{Binding Game, StringFormat='Spil: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding TotalCards, StringFormat='{0} kort i sættet'}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>

                            <!-- Pil -->
                            <Label Grid.Column="2"
                                   Text="➔"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>