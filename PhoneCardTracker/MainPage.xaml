<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PhoneCardTracker.ViewModels"
             xmlns:models="clr-namespace:PhoneCardTracker.Models"
             xmlns:services="clr-namespace:PhoneCardTracker.Services"
             x:Class="PhoneCardTracker.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Card Sets">

    <!-- Root Grid containing the primary layout and modal overlays -->
    <Grid>

        <!-- 1. Primary Page Content -->
        <Grid RowDefinitions="Auto, *" Padding="16">
            <VerticalStackLayout Grid.Row="0" Spacing="10">

                <!-- Sync & Cloud Status Header -->
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Card Database"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                        <Label Text="{Binding StatusMessage}"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>

                    <!-- GitHub Catalog Sync -->
                    <Button Grid.Column="1"
                            Text="Sync GitHub"
                            FontSize="12"
                            Padding="12,6"
                            HeightRequest="36"
                            Clicked="OnSyncClicked" />

                    <!-- Firebase Realtime Cloud Sync -->
                    <Button Grid.Column="2"
                            Text="☁ Cloud"
                            FontSize="12"
                            Padding="12,6"
                            HeightRequest="36"
                            BackgroundColor="#0284C7"
                            TextColor="White"
                            Clicked="OnCloudSyncClicked" />
                </Grid>

                <!-- Loading Activity Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

                <!-- Game / Category Selection Dropdown -->
                <Label Text="Select Game or Category"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource Gray400}"
                        Padding="10,0">
                    <Picker x:Name="GamePicker"
                            Title="Choose game / category..."
                            ItemsSource="{Binding Games}"
                            SelectedItem="{Binding SelectedGame, Mode=TwoWay}" />
                </Border>

                <!-- Search Input Bar -->
                <SearchBar Placeholder="Search sets..."
                           Text="{Binding SearchText}"
                           CancelButtonColor="{StaticResource Primary}" />

                <Label Text="Available Sets"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,4,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </VerticalStackLayout>

            <!-- Card Sets Collection List -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding AvailableSets}"
                            SelectionMode="None"
                            Margin="0,6,0,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,40">
                        <Label Text="No sets found"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray400}" />
                        <Label Text="If '★ Favorites' is chosen, tap the star next to any set to add it."
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray500}"
                               Padding="20,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CardSet">
                        <Border Margin="0,4"
                                Padding="12,10"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Stroke="{StaticResource Gray500}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSetTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Favorite Toggle Star -->
                                <Button Grid.Column="0"
                                        Text="{Binding FavoriteIcon}"
                                        TextColor="{Binding FavoriteColor}"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Clicked="OnFavoriteStarClicked"
                                        CommandParameter="{Binding .}" />

                                <!-- Set Details -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding SetName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding Game}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalCards, StringFormat='• {0} cards'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Navigation Arrow Indicator -->
                                <Label Grid.Column="2"
                                       Text="➔"
                                       FontSize="18"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 2. Obsolete Items Removal Modal Overlay -->
        <Grid x:Name="ObsoleteItemsModal"
              IsVisible="False"
              InputTransparent="False"
              BackgroundColor="#AA000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBlockTapped" />
            </Grid.GestureRecognizers>

            <Border WidthRequest="340"
                    MaximumHeightRequest="520"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                    Stroke="{StaticResource Gray600}"
                    StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBlockTapped" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Spacing="3">
                        <Label Text="Removed Items Found"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <Label Text="The following items exist locally but are no longer in GitHub. Do you want to remove them?"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>

                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Gray200}" />

                    <!-- Scrollable List of Obsolete Items -->
                    <CollectionView Grid.Row="2"
                                    x:Name="ObsoleteItemsCollectionView"
                                    MaximumHeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:ObsoleteItemReport">
                                <Border Margin="0,3"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Confirmation Action Buttons -->
                    <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Keep Them"
                                BackgroundColor="{StaticResource Gray600}"
                                TextColor="White"
                                HeightRequest="40"
                                Clicked="OnDismissObsoleteClicked" />

                        <Button Grid.Column="1"
                                Text="Remove Items"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                HeightRequest="40"
                                Clicked="OnConfirmRemoveObsoleteClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>